  "methodology": "2006 IPCC Guidelines for National Greenhouse Gas Inventories",
  "readme": "Every record carries a provenance class. 'ipcc' values were read directly from the cited table of the 2006 IPCC Guidelines. 'external' values come from outside the Guidelines and must name their own source. 'assumed' values are our own simplifications. Nothing in this file may be treated as verified unless verified is true.",

  "provenance_classes": {
    "ipcc": "Read directly from a named table of the 2006 IPCC Guidelines.",
    "external": "Sourced outside the Guidelines. Must be labelled as such in the UI.",
    "assumed": "Our own estimate or simplification. Must be labelled as such in the UI."
  },

  "uncertainty_convention": {
    "interval": "95 percent confidence interval as published by the IPCC",
    "note": "Several IPCC intervals are asymmetric about the default value. Where the engine treats them as symmetric for Approach 1 error propagation (Vol 1 Ch 3 Eq 3.1 and 3.2), it must flag that simplification in the audit trail.",
    "method_multiplication": "U_total = sqrt(U1^2 + U2^2 + ... + Un^2)  [Vol 1 Ch 3, Eq 3.1]",
    "method_addition": "U_total = sqrt(sum((Ui * xi)^2)) / sum(xi)  [Vol 1 Ch 3, Eq 3.2]"
  },

  "categories": {
    "1A4b": "Energy > Fuel combustion > Other sectors > Residential",
